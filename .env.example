# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Alternative: Gemini via its OpenAI-compatible endpoint (used when GEMINI_API_KEY is set)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Alternative: any OpenAI-compatible Chat Completions endpoint (takes priority when set)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://mkp-api.fptcloud.com/v1
LLM_MODEL=DeepSeek-V4-Flash
